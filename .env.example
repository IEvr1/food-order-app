# Food Order App — environment template
# Copy to `.env` and fill in values. Use a NEW database (not salon_booking).

# PostgreSQL — create a dedicated database, e.g.:
#   createdb food_order
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_order?schema=public"

# Public app URL — customer chat + owner dashboard (production: foodorder.nexaipla.com)
APP_BASE_URL="http://localhost:3002"
# Short links in SMS (production: orders.nexaipla.com)
# SMS_LINK_BASE_URL="https://orders.nexaipla.com"

# Secrets (required in production)
SMS_LINK_SECRET="change-me-in-production"
DASHBOARD_LINK_SECRET="change-me-in-production"

# Google Maps (delivery address picker, shop settings, delivery ETA via Routes API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional server-only key (falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY)
# GOOGLE_MAPS_API_KEY=""

# SMS — Twilio and/or self-hosted gateway
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
# TWILIO_ALPHA_SENDER_ID=""
# SMS_GATEWAY_URL=""
# SMS_GATEWAY_API_KEY=""

# Optional
# DATA_RETENTION_DAYS=365
