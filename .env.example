# Food Order App — environment template
# Copy to `.env` and fill in values. Use a NEW database (not salon_booking).

# PostgreSQL — create a dedicated database, e.g.:
#   createdb food_order
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_order?schema=public"

# Public URL for this shop — chat, dashboard, and SMS manage links (/l/:code) share this domain.
# Production example per restaurant: https://souvlaki.nexaipla.com
APP_BASE_URL="http://localhost:3002"

# Secrets (required in production)
SMS_LINK_SECRET="change-me-in-production"
DASHBOARD_LINK_SECRET="change-me-in-production"

# WebSMS (websms.com.cy) — sole SMS provider for order notifications
# Generate REST API key: https://www.websms.com.cy/en/sms-api
WEBSMS_API_KEY=""
WEBSMS_SENDER_ID=""
# Optional: default https://api.websms.com
# WEBSMS_GATEWAY_URL="https://api.websms.com"
# Optional: max concatenated SMS parts (default 3)
# WEBSMS_MAX_SMS_PER_MESSAGE="3"
# Optional: set to "true" to validate API without sending
# WEBSMS_TEST="false"
